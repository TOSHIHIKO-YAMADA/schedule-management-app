generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id                   String                @id @default(cuid())
  employeeNumber       String                @unique
  name                 String
  nameKana             String
  email                String                @unique
  phone                String
  lineId               String?
  notificationMethod   String                @default("email")
  nearestStation       String
  transportation       String                @default("train")
  role                 String                @default("general")
  department           String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  clerkId              String?               @unique
  activityLogs         ActivityLog[]
  notificationSettings NotificationSettings?
  scheduleAttendees    ScheduleAttendee[]
  createdSchedules     Schedule[]            @relation("CreatedBy")
  assignedTasks        Task[]                @relation("AssignedTo")

  @@map("employees")
}

model Customer {
  id            String     @id @default(cuid())
  name          String
  address       String
  phone         String
  contactPerson String
  email         String
  website       String?
  industry      String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  schedules     Schedule[]

  @@map("customers")
}

model Vehicle {
  id             String         @id @default(cuid())
  name           String
  licensePlate   String         @unique
  inspectionDate String
  type           String         @default("sedan")
  capacity       Int            @default(5)
  fuelType       String         @default("gasoline")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  schedules      Schedule[]
  vehicleUsages  VehicleUsage[]

  @@map("vehicles")
}

model Schedule {
  id                      String             @id @default(cuid())
  title                   String
  description             String
  startDate               String
  endDate                 String
  startTime               String
  endTime                 String
  category                String             @default("meeting")
  priority                String             @default("medium")
  location                String
  status                  String             @default("scheduled")
  isRecurring             Boolean            @default(false)
  customerId              String?
  vehicleId               String?
  createdBy               String
  reminderEnabled         Boolean            @default(false)
  reminderMinutesBefore   Int?
  recurringType           String?
  recurringInterval       Int?
  recurringDaysOfWeek     String?
  recurringEndDate        String?
  recurringMaxOccurrences Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  activityLogs            ActivityLog[]
  attendees               ScheduleAttendee[]
  creator                 Employee           @relation("CreatedBy", fields: [createdBy], references: [id])
  vehicle                 Vehicle?           @relation(fields: [vehicleId], references: [id])
  customer                Customer?          @relation(fields: [customerId], references: [id])
  tasks                   Task[]

  @@map("schedules")
}

model ScheduleAttendee {
  id         String   @id @default(cuid())
  scheduleId String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, employeeId])
  @@map("schedule_attendees")
}

model Task {
  id           String        @id @default(cuid())
  title        String
  description  String
  priority     String        @default("medium")
  status       String        @default("pending")
  dueDate      String
  progress     Int           @default(0)
  assignedTo   String
  scheduleId   String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id])
  assignee     Employee      @relation("AssignedTo", fields: [assignedTo], references: [id])

  @@map("tasks")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  entityName  String
  description String
  timestamp   DateTime @default(now())
  userId      String
  schedule    Task     @relation(fields: [entityId], references: [id])
  schedule    Schedule @relation(fields: [entityId], references: [id])
  user        Employee @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model VehicleUsage {
  id            String   @id @default(cuid())
  startDateTime DateTime
  endDateTime   DateTime
  purpose       String
  mileageStart  Int?
  mileageEnd    Int?
  vehicleId     String
  employeeId    String
  scheduleId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_usages")
}

model NotificationSettings {
  id                     String   @id @default(cuid())
  scheduleReminder       Boolean  @default(true)
  vehicleInspectionAlert Boolean  @default(true)
  taskDeadlineAlert      Boolean  @default(true)
  emailNotifications     Boolean  @default(true)
  lineNotifications      Boolean  @default(false)
  reminderMinutes        Int      @default(30)
  userId                 String   @unique
  user                   Employee @relation(fields: [userId], references: [id])

  @@map("notification_settings")
}
